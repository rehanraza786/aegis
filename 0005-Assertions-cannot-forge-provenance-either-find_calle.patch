 payload/ariadne-node/server.mjs   | 11 ++++++++++-
 payload/ariadne-python/indexer.py | 21 ++++++++++++++++++---
 payload/ariadne-python/server.py  | 15 ++++++++++++++-
 tests/run_tests.py                | 14 ++++++++++++++
 5 files changed, 70 insertions(+), 8 deletions(-)

