+    return { error: `Multi-root workspace: pass root=<repo> so ${what} lands in a git-versioned repo the indexer parses. Roots: ${prefixes.join(", ")}.` };
+  }
+  return { baseDir: rootDir(pick), sourceBase: WS_BASE };
