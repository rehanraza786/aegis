From 1d54f5ad47265d8b539ed6b6660c7e84ffdf1c93 Mon Sep 17 00:00:00 2001
From: rehanraza786 <rehanraza786@users.noreply.github.com>
Date: Wed, 29 Jul 2026 01:30:05 +0000
Subject: [PATCH 06/12] Regenerate package-lock.json: it disagreed with
 package.json

The lockfile declared ariadne-node@1.4.0 while package.json declares
aegis-ariadne@0.2.0. `npm ci` refuses to install against a lockfile that
disagrees with the manifest, so the publish workflow could not have been
running clean. Regenerated with --package-lock-only (no dependency
changes, name and version only) and verified `npm ci` now exits 0.
---
 payload/ariadne-node/package-lock.json | 14 ++++++++++----
 1 file changed, 10 insertions(+), 4 deletions(-)

diff --git a/payload/ariadne-node/package-lock.json b/payload/ariadne-node/package-lock.json
index a6bf02d..a0261b3 100644
--- a/payload/ariadne-node/package-lock.json
+++ b/payload/ariadne-node/package-lock.json
@@ -1,12 +1,13 @@
 {
-  "name": "ariadne-node",
-  "version": "1.4.0",
+  "name": "aegis-ariadne",
+  "version": "0.2.0",
   "lockfileVersion": 3,
   "requires": true,
   "packages": {
     "": {
-      "name": "ariadne-node",
-      "version": "1.4.0",
+      "name": "aegis-ariadne",
+      "version": "0.2.0",
+      "license": "MIT",
       "dependencies": {
         "@modelcontextprotocol/sdk": "^1.0.0",
         "better-sqlite3": "^11.0.0",
@@ -16,6 +17,11 @@
         "web-tree-sitter": "0.24.7",
         "zod": "^3.23.0"
       },
+      "bin": {
+        "aegis-ariadne": "server.mjs",
+        "aegis-ariadne-docgen": "docgen.mjs",
+        "aegis-ariadne-index": "indexer.mjs"
+      },
       "engines": {
         "node": ">=18"
       }
-- 
